DATABASE_URL="postgresql://user:password@localhost:5432/habit_tracker"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
PORT=3000

FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Push Notifications (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
PUSH_VAPID_SUBJECT="mailto:admin@yourdomain.com"
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# Cron Secret (must match vercel.json cron config)
CRON_SECRET="your-cron-secret-change-in-production"
