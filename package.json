{
  "name": "habit-tracker-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev": "npm run dev:web & npm run dev:api",
    "build": "turbo build",
    "start": "bun run apps/api/src/index.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "react-router-dom": "^7.13.2"
  }
}
